# Copy this file to .env (locally) and set the same values in
# Netlify → Site settings → Environment variables (for the deployed site).
# Never commit the real .env file.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Cloud Console → APIs & Services → Credentials → OAuth Client ID
# (Web application). Leave blank for now — the Manage Listing "Sign in
# with Google" button falls back to a design-review mock until this is set.
VITE_GOOGLE_CLIENT_ID=

# Admin passcode — change this anytime by updating the value here (locally)
# and in Netlify's environment variables, then redeploying. Falls back to
# "sharedclassrooms2026" if left blank, so it still works before you set one.
VITE_ADMIN_PASSCODE=

# Server-side only (used by Netlify Functions, never bundled into the site).
# Resend API key for notification emails.
RESEND_API_KEY=
# Where "new listing submitted" emails go. Comma-separate to notify several
# people. If blank, listing notifications are simply skipped.
ADMIN_NOTIFY_EMAIL=
